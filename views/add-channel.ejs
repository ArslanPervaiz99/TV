<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= pageTitle %></title>
    <!-- Add Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div
      class="max-w-md mx-auto bg-white rounded-xl shadow-md overflow-hidden p-8"
    >
      <h1 class="text-3xl font-bold text-center text-gray-900 mb-8">
        Add New Channel
      </h1>

      <% if (typeof errorMessage !== 'undefined') { %>
      <p class="text-red-500 text-sm mb-4 text-center"><%= errorMessage %></p>
      <% } %>

      <form
        action="/add-channel"
        method="POST"
        enctype="multipart/form-data"
        class="space-y-6"
      >
        <div>
          <label
            for="name"
            class="block text-sm font-medium text-gray-700 mb-2"
          >
            Channel Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            value="<%= oldInput ? oldInput.name : '' %>"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          />
        </div>

        <div>
          <label
            for="embedCode"
            class="block text-sm font-medium text-gray-700 mb-2"
          >
            Embed Code
          </label>
          <textarea
            id="embedCode"
            name="embedCode"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 h-32"
          >
<%= oldInput ? oldInput.embedCode : '' %></textarea
          >
        </div>

        <div>
          <label
            for="logoUrl"
            class="block text-sm font-medium text-gray-700 mb-2"
          >
            Logo URL
          </label>
          <input
            type="file"
            id="logoUrl"
            name="logoUrl"
            accept="image/*"
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition duration-150 ease-in-out"
        >
          Add Channel
        </button>
      </form>
    </div>
  </body>
</html>
