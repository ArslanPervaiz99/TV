<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TV Channels</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-gradient-to-br from-gray-900 via-indigo-950 to-gray-900 min-h-screen p-6 font-[Inter]"
  >
    <div class="max-w-7xl mx-auto">
      <!-- Header Section -->
      <div class="text-center mb-12">
        <h1 class="text-5xl font-bold mb-4">
          <span
            class="bg-clip-text text-transparent bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500"
          >
            TV Channels
          </span>
        </h1>
        <p class="text-gray-400 text-lg">Stream your favorite channels live</p>
      </div>

      <!-- Channels Grid -->
      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-8"
      >
        <% channels.forEach(channel => { %>
        <div class="transform transition-all duration-300 hover:scale-105">
          <!-- Card -->
          <div
            class="relative bg-white/10 backdrop-blur-lg rounded-2xl overflow-hidden p-6 border border-white/10 h-full flex flex-col"
          >
            <!-- Logo Container -->
            <div class="aspect-square mb-4">
              <div
                class="w-full h-full flex items-center justify-center bg-gray-900/50 rounded-xl p-4"
              >
                <img
                  src="/uploads/<%= channel.logoUrl %>"
                  alt="<%= channel.name %>"
                  class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-110"
                />
              </div>
            </div>

            <!-- Channel Name -->
            <h2
              class="text-lg font-semibold text-center text-gray-100 mb-4 flex-grow"
            >
              <%= channel.name %>
            </h2>

            <!-- Play Button -->
            <a
              href="/play/<%= channel._id %>"
              class="block w-full text-center py-3 px-6 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-xl font-medium hover:from-purple-700 hover:to-pink-700 transition-colors duration-300"
            >
              <span class="flex items-center justify-center">
                <svg
                  class="w-5 h-5 mr-2"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M4 4l12 6-12 6V4z" />
                </svg>
                Watch Live
              </span>
            </a>
          </div>
        </div>
        <% }) %>
      </div>

      <!-- Footer -->
      <footer class="mt-16 text-center text-gray-500 text-sm">
        <p>
          © <%= new Date().getFullYear() %> TV Channels. All rights reserved.
        </p>
      </footer>
    </div>
  </body>
</html>
